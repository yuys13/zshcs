#!/usr/bin/env bash
# ==============================================================================
# .githooks/pre-commit
#
# Git native pre-commit hook for zshcs.
# Configured via `git config core.hooksPath .githooks`.
# Ensures formatting, clippy linting, builds, and Rust/Zsh test suites pass
# before allowing commits.
# ==============================================================================

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# If Nix is available and not already inside a Nix dev environment,
# re-execute this script inside `nix develop`.
if [[ -z "${IN_NIX_SHELL:-}" && -z "${__ZSHCS_HOOK_REEXEC:-}" ]] && command -v nix >/dev/null 2>&1; then
    export __ZSHCS_HOOK_REEXEC=1
    exec nix develop -c "$0" "$@"
fi

echo "=== Running zshcs pre-commit checks ==="
if [[ -n "${IN_NIX_SHELL:-}" ]]; then
    echo "(Running inside Nix devShell environment)"
fi

echo "[1/4] Checking formatting..."
if command -v nix >/dev/null 2>&1; then
    nix fmt -- --fail-on-change
else
    cargo fmt --check
fi

echo "[2/4] Running Clippy linter (cargo clippy)..."
cargo clippy -q --no-deps --all-targets -- -D warnings

echo "[3/4] Building project (cargo build)..."
cargo build -q

echo "[4/4] Running test suite (cargo test --all-targets)..."
cargo test -q --all-targets

echo "=== All pre-commit checks passed successfully! ==="
